NODE_ENV=development
PORT=8080

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Main platform database — stores users, batches, sprints, exams, attempts,
# analytics, reports, syllabus, blueprint, and all other platform data.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/examneeti?retryWrites=true&w=majority

# Question Bank database — separate DB on the same Atlas cluster.
# Stores Question documents with patternSlotTags and usageLog.
QUESTION_BANK_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/questionbank?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<strong_random_secret_min_64_chars>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<strong_random_refresh_secret_min_64_chars>
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Email — Brevo (formerly Sendinblue) SMTP ─────────────────────────────────
# Get credentials from: Brevo Dashboard → SMTP & API → SMTP tab
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@example.com
BREVO_SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM_NAME=Exam Neeti
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Set to "true" ONLY in local dev/test — never in production
DISABLE_RATE_LIMIT=false

# ─── CORS / Client ────────────────────────────────────────────────────────────
# Comma-separated for multiple origins: http://localhost:3000,https://yourapp.com
CLIENT_URL=http://localhost:3000

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=<strong_cookie_secret_min_32_chars>

# ─── Render Deployment ───────────────────────────────────────────────────────
# Set to "true" only on Render — trusts X-Forwarded-For header from proxy
TRUST_PROXY=true

# ─── Super Admin Seed (used by seedAdmin.js only) ────────────────────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=superadmin@examneeti.com
SEED_ADMIN_PASSWORD=<strong_password_min_12_chars>

# ─── Cloudinary (used by scripts/seedQuestions.js for question images) ────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Gemini (rich bulk-upload equation → LaTeX conversion) ────────────────────
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Pin the exact model id available on your key — check Google AI Studio for
# the current model list before deploying; this default may be stale.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENCY=5
GEMINI_TIMEOUT_MS=30000

# ─── LibreOffice (rasterizes legacy MathType/WMF/EMF equation images) ─────────
# On a Linux VPS: `sudo apt install libreoffice` then leave this as "soffice"
# (must be on PATH). Only needed for the .docx bulk-upload rich pipeline —
# unrelated to LibreOffice being absent in local Windows dev (there is no
# Windows-specific code path in the shipped rasterizer; it always shells out
# to `soffice`, so bulk-upload equation conversion will fail locally on
# Windows unless LibreOffice for Windows is installed and on PATH too).
LIBREOFFICE_BIN=soffice
LIBREOFFICE_TIMEOUT_MS=60000
# Equations rasterized per `soffice` invocation. LibreOffice itself is a
# full office-suite process (~150-300MB RAM) regardless of chunk size — keep
# this LOW on any host with limited RAM (a large chunk risks the OS
# OOM-killing the WHOLE service, not just the request — confirmed on
# Render's free 512MB plan with a 226-equation document). Raise this once
# deployed on a host with real memory headroom (2GB+).
LIBREOFFICE_CHUNK_SIZE=10
# Hard ceiling on embedded equations accepted in one rich-docx bulk upload —
# a fail-fast safety net so an unusually equation-heavy document is
# rejected immediately with a clear message instead of risking an
# out-of-memory crash partway through. Lower on tight-RAM hosts, raise on
# a VPS with real headroom.
MAX_BULK_EQUATIONS=400
